{
	"name": "UNSW Quarto slides template",
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": { "version": "1.10.18" },
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},
	"containerEnv": {
		"VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
		"QUARTO_PYTHON": "${containerWorkspaceFolder}/.venv/bin/python",
		"CHROME_PATH": "/usr/bin/chromium",
		"UV_LINK_MODE": "copy",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
	},
	"mounts": [
		"source=unsw-quarto-uv-cache,target=/home/vscode/.cache/uv,type=volume",
		"source=unsw-quarto-slides-template-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
		"source=unsw-quarto-slides-template-claude,target=/home/vscode/.claude,type=volume"
	],
	"postCreateCommand": "sudo chown vscode:vscode .venv && uv venv --allow-existing --python 3.13 .venv && uv pip install jupyter matplotlib seaborn",
	"customizations": {
		"vscode": {
			"extensions": [
				"quarto.quarto",
				"ms-python.python",
				"ms-toolsai.jupyter"
			]
		}
	}
}
